# =============================================================================
# ASCENCIO TAX INC. API - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# IMPORTANT: This is a template file. DO NOT add real credentials here.
# Copy this file to .env and replace all placeholder values with real ones.
# Command: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
API_PORT="3000"
STAGE="dev" # dev, test, prod

# Reverse proxy trust setting used to resolve client IP correctly.
# Examples: "false", "true", "1", "2", "loopback".
TRUST_PROXY="1"

# -----------------------------------------------------------------------------
# WEB CONFIGURATION
# -----------------------------------------------------------------------------
WEB_PORT="4000"

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="5432"
DB_USERNAME="postgres"
DB_PASSWORD="password"
DB_NAME="ascencio_tax"

# -----------------------------------------------------------------------------
# JWT (JSON Web Token) CONFIGURATION
# -----------------------------------------------------------------------------
JWT_SECRET="jwt_secret_key"
JWT_EXPIRY="60m"

# -----------------------------------------------------------------------------
# EMAIL VERIFICATION SETTINGS
# -----------------------------------------------------------------------------
VERIFICATION_CODE_TTL="15"

# -----------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (SMTP)
# -----------------------------------------------------------------------------
EMAIL_USER="user@email.com"
EMAIL_PASS="email_password"
SENDER_NAME="Your Company Name"
ENTERPRISE_EMAIL="notify@email.com"

# -----------------------------------------------------------------------------
# MAILERSEND CONFIGURATION (Production)
# For local development, use MailHog
# -----------------------------------------------------------------------------
MAILERSEND_API_KEY="mailersend_api_key"
MAILERSEND_SENDER_EMAIL="sender@email.com"
MAILERSEND_SENDER_EMAIL_REPLY_TO="reply@email.com"
MAILERSEND_SENDER_NAME="Your Company Name"

# -----------------------------------------------------------------------------
# BUSINESS SETTINGS
# -----------------------------------------------------------------------------
SLOT_STEP_MINUTES_DEFAULT="15"
BUSINESS_TZ="America/Toronto"


# -----------------------------------------------------------------------------
# CLOUDINARY CONFIGURATION (Image/File Storage)
# -----------------------------------------------------------------------------
CLOUDINARY_NAME="cloudinary_name"
CLOUDINARY_API_KEY="cloudinary_api_key"
CLOUDINARY_API_SECRET="cloudinary_api_secret"

# -----------------------------------------------------------------------------
# GOOGLE SERVICES CONFIGURATION
# Share calendar account with this service account email
# GOOGLE_CALENDAR_ID is the calendar ID of the calendar you want to use
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="calendar_id@group.calendar.google.com"

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (CLIENT) CONFIGURATION
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# Callback URL para el OAuth de Calendar (diferente al de login)
GOOGLE_CALENDAR_CALLBACK_URL="http://localhost:3000/api/v1/calendar/oauth/callback"

# Frontend base y post-login redirect
WEB_APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:8081"
OAUTH_SUCCESS_REDIRECT="/es/admin"

# -----------------------------------------------------------------------------
# CALENDAR OAUTH & WEBHOOKS
# Necesario para conexiones personales de staff/empresa/clientes
# -----------------------------------------------------------------------------
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY="your_64_char_hex_encryption_key_here"
# URL base para webhooks de Google Calendar (ngrok en dev, Railway URL en prod)
WEBHOOK_BASE_URL="https://your-ngrok-or-railway-url.com"
# URL publica de la API (usada por el sistema internamente)
API_URL="http://localhost:3000"
# -----------------------------------------------------------------------------
# ZOOM API CONFIGURATION
# -----------------------------------------------------------------------------
ZOOM_ACCOUNT_ID="zoom_account_id"
ZOOM_CLIENT_ID="zoom_client_id"
ZOOM_CLIENT_SECRET="zoom_client_secret"

# -----------------------------------------------------------------------------
# OPENAI API CONFIGURATION
# -----------------------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
# NEVER commit this key to version control
OPENAI_API_KEY="openai_api_key"

# -----------------------------------------------------------------------------
# GEOLOCATION PROXY CONFIGURATION
# -----------------------------------------------------------------------------
# Provider key must only live on backend. Never expose this key to mobile/web.
IPAPI_ACCESS_KEY="ipapi_access_key"

# Timeout for external geolocation provider requests (milliseconds)
GEOLOCATION_PROVIDER_TIMEOUT_MS="5000"

# In-memory cache TTL for geolocation lookups by IP (milliseconds)
GEOLOCATION_CACHE_TTL_MS="86400000"

# Fixed-window rate limit per source IP
GEOLOCATION_RATE_LIMIT_MAX_REQUESTS="30"
GEOLOCATION_RATE_LIMIT_WINDOW_MS="60000"

# Retry and circuit-breaker settings
GEOLOCATION_RETRY_ATTEMPTS="2"
GEOLOCATION_RETRY_DELAY_MS="250"
GEOLOCATION_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
GEOLOCATION_CIRCUIT_BREAKER_OPEN_MS="30000"

# -----------------------------------------------------------------------------
# MOBILE RUNTIME CONFIG (PUBLIC VALUES SERVED BY API)
# -----------------------------------------------------------------------------
# Optional fallback values used when system settings do not contain
# mobile.cloudinaryCloudName / mobile.googleWebClientId / store URLs.
MOBILE_CLOUDINARY_CLOUD_NAME=""
MOBILE_GOOGLE_WEB_CLIENT_ID=""
MOBILE_APP_STORE_URL=""
MOBILE_PLAY_STORE_URL=""

# Cache TTL for GET /api/v1/mobile-config response generation (milliseconds)
MOBILE_CONFIG_CACHE_TTL_MS="300000"

# =============================================================================
# SECURITY REMINDERS:
# - NEVER commit the .env file to version control
# - Add .env to .gitignore (should already be there)
# - Use strong, unique passwords for all services
# - Rotate secrets regularly, especially in production
# - Use environment-specific .env files (.env.dev, .env.prod)
# - Consider using a secrets manager for production (AWS Secrets Manager, etc.)
# =============================================================================
